          }
        ],
        "partitions": [
          {
            "name": "Network",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"date\", \"scheduled\", \"flown\", \"cancelled\", \"dep_on_time\", \"arr_on_time\", \"dep_delayed\", \"arr_delayed\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date\", type date}, {\"scheduled\", Int64.Type}, {\"flown\", Int64.Type}, {\"cancelled\", Int64.Type}, {\"dep_on_time\", Int64.Type}, {\"arr_on_time\", Int64.Type}, {\"dep_delayed\", Int64.Type}, {\"arr_delayed\", Int64.Type}}, \"en-AU\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "description": "Entire reporting-airline network benchmark. Never add to Flights. July 2025 delayed counts contain a disclosed source exception."
      }
    ],
    "relationships": [

              ]
            }
          }
        ]
      },
      {
        "name": "Routes",
        "columns": [
          {
            "name": "route_id",
            "dataType": "int64",
            "sourceColumn": "route_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "route",
            "dataType": "string",
            "sourceColumn": "route",
            "summarizeBy": "none"
          },
          {

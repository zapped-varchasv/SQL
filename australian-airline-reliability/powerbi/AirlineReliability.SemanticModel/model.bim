          },
          {
            "name": "destination",
            "dataType": "string",
            "sourceColumn": "destination",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Routes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"route_id\", \"route\", \"origin\", \"destination\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"route_id\", Int64.Type}, {\"route\", type text}, {\"origin\", type text}, {\"destination\", type text}}, \"en-AU\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Flights",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "airline_id",
            "dataType": "int64",
            "sourceColumn": "airline_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "route_id",
            "dataType": "int64",
            "sourceColumn": "route_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "scheduled",
            "dataType": "int64",
            "sourceColumn": "scheduled",
            "summarizeBy": "sum"
          },
          {
            "name": "flown",
            "dataType": "int64",
            "sourceColumn": "flown",
            "summarizeBy": "sum"
          },
          {
            "name": "cancelled",
            "dataType": "int64",
            "sourceColumn": "cancelled",
            "summarizeBy": "sum"
          },
          {
            "name": "dep_on_time",
            "dataType": "int64",
            "sourceColumn": "dep_on_time",
            "summarizeBy": "sum"
          },
          {
            "name": "arr_on_time",
            "dataType": "int64",
            "sourceColumn": "arr_on_time",
            "summarizeBy": "sum"
          },
          {
            "name": "dep_delayed",
            "dataType": "int64",
            "sourceColumn": "dep_delayed",
            "summarizeBy": "sum"
          },
          {
            "name": "arr_delayed",
            "dataType": "int64",
            "sourceColumn": "arr_delayed",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Flights",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"date\", \"airline_id\", \"route_id\", \"scheduled\", \"flown\", \"cancelled\", \"dep_on_time\", \"arr_on_time\", \"dep_delayed\", \"arr_delayed\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date\", type date}, {\"airline_id\", Int64.Type}, {\"route_id\", Int64.Type}, {\"scheduled\", Int64.Type}, {\"flown\", Int64.Type}, {\"cancelled\", Int64.Type}, {\"dep_on_time\", Int64.Type}, {\"arr_on_time\", Int64.Type}, {\"dep_delayed\", Int64.Type}, {\"arr_delayed\", Int64.Type}}, \"en-AU\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Scheduled sectors",
            "expression": "SUM(Flights[scheduled])",
            "displayFolder": "Volume",
            "formatString": "#,0"
          },
          {
            "name": "Flown sectors",
            "expression": "SUM(Flights[flown])",
            "displayFolder": "Volume",
            "formatString": "#,0"
          },
          {
            "name": "Cancellations",
            "expression": "SUM(Flights[cancelled])",
            "displayFolder": "Volume",
            "formatString": "#,0"
          },
          {
            "name": "Delayed arrivals",
            "expression": "SUM(Flights[arr_delayed])",
            "displayFolder": "Volume",
            "formatString": "#,0"
          },
          {
            "name": "Cancellation rate",
            "expression": "DIVIDE([Cancellations], [Scheduled sectors])",
            "displayFolder": "Reliability",
            "formatString": "0.00%"
          },
          {
            "name": "Arrival OTP",
            "expression": "DIVIDE(SUM(Flights[arr_on_time]), [Flown sectors])",
            "displayFolder": "Reliability",
            "formatString": "0.00%"
          },
          {
            "name": "Departure OTP",
            "expression": "DIVIDE(SUM(Flights[dep_on_time]), [Flown sectors])",
            "displayFolder": "Reliability",
            "formatString": "0.00%"
          },
          {
            "name": "Arrival OTP prior year",
            "expression": "CALCULATE([Arrival OTP], SAMEPERIODLASTYEAR(Calendar[date]))",
            "displayFolder": "Time intelligence",
            "formatString": "0.00%"
          },
          {
            "name": "Arrival change pp",
            "expression": "IF(NOT ISBLANK([Arrival OTP prior year]), 100 * ([Arrival OTP] - [Arrival OTP prior year]))",
            "displayFolder": "Time intelligence",
            "formatString": "+0.00;-0.00;0.00"
          },
          {
            "name": "Cancellation rate 3M",
            "expression": "VAR EndDate = MAX(Calendar[date]) RETURN CALCULATE([Cancellation rate], DATESINPERIOD(Calendar[date], EndDate, -3, MONTH))",
            "displayFolder": "Time intelligence",
            "formatString": "0.00%"
          },
          {
            "name": "Route cancellation rank",
            "expression": "IF([Scheduled sectors] > 0, RANKX(ALLSELECTED(Routes[route]), [Cancellations], , DESC, DENSE))",
            "displayFolder": "Prioritisation",
            "formatString": "0"
          },
          {
            "name": "Top 10 cancellations",
            "expression": "IF([Route cancellation rank] <= 10, [Cancellations])",
            "displayFolder": "Prioritisation",
            "formatString": "#,0"
          },
          {
            "name": "Cancellation share",
            "expression": "DIVIDE([Cancellations], CALCULATE([Cancellations], ALLSELECTED(Routes[route])))",
            "displayFolder": "Prioritisation",
            "formatString": "0.0%"
          },
          {
            "name": "Months reported",
            "expression": "DISTINCTCOUNT(Flights[date])",
            "displayFolder": "Coverage",
            "formatString": "0"
          },
          {
            "name": "Coverage note",
            "expression": "IF([Months reported] < 12, \"Partial year or filtered period\", IF([Scheduled sectors] < 1000, \"Low volume: interpret cautiously\", \"12+ months; inspect route mix\"))",
            "displayFolder": "Coverage"
          },
          {
            "name": "Network arrival OTP",
            "expression": "DIVIDE(SUM(Network[arr_on_time]), SUM(Network[flown]))",
            "displayFolder": "Network benchmark",
            "formatString": "0.00%"
          },
          {
            "name": "Network cancellation rate",
            "expression": "DIVIDE(SUM(Network[cancelled]), SUM(Network[scheduled]))",
            "displayFolder": "Network benchmark",
            "formatString": "0.00%"
          }
        ]
      },
      {
        "name": "Network",
        "columns": [
          {

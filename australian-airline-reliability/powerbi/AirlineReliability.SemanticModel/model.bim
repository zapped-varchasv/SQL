              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlTSUXLKz6tKVIrViVYyAvK8UkuKSxKLwHxjID8wMa8ksRjMNYFzfTLzssFCpkChoNQKBcfMopzMvFSIOjOgYFhmUXpmnoJjaXFJUWJOJsR8cywSCkGp6Zn5eYk5SGbEAgA=\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"airline_id\", \"airline\"}),",
